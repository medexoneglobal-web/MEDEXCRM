# CRM Automated OneDrive Backup Configuration

# AES-256 encryption key (32 bytes, base64 encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# Daily backup schedule (cron format, default 00:00)
BACKUP_TIME=0 0 * * *

# Retention policy (days)
BACKUP_RETENTION_DAYS=30

# OneDrive / Microsoft Graph delegated auth
# 1. Register an Azure AD app with redirect URI http://localhost:3001/auth/callback
# 2. Add delegated Microsoft Graph permission: Files.ReadWrite
# 3. Run: node scripts/get-onedrive-token.js
# 4. Copy the refresh token below
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REFRESH_TOKEN=

# OneDrive folder ID where backups are stored.
# Open the folder in OneDrive web, note the DriveItem ID from the URL, or use Graph Explorer.
ONEDRIVE_BACKUP_FOLDER_ID=

# SMTP configuration for failure alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Failure alert recipient
BACKUP_ALERT_EMAIL=allsupport@medexoneglobal.com

# --- WhatsApp module (whatsapp-web.js backend, always-on host: Render/Railway/local) ---
# Shared secret the CRM frontend sends as the x-wa-secret header (mutating endpoints)
WA_API_SECRET=
# Session folder for the paired WhatsApp account (mount a persistent disk here on Render;
# on Render Free use /tmp/wa-session — the Supabase backup below protects the pairing)
WA_SESSION_PATH=./whatsapp-session
# Delay between messages in a blast (ms) — jitter of up to 1s is added per message
WA_SEND_DELAY_MS=2000
# Allowed browser origin for the WhatsApp API (your CRM URL). * = allow any (dev only)
WA_CORS_ORIGIN=*
# Supabase credentials used by the backend to store blasts/history
# SUPABASE_URL=...
# SUPABASE_SERVICE_ROLE_KEY=...

# --- Free-tier resilience (no disk available) ---
# Reconnect automatically after every restart/sleep-wake (session restored from backup)
WA_AUTO_CONNECT=false
# How long after boot to auto-connect (ms)
WA_AUTO_CONNECT_DELAY_MS=15000
# How often to back up the pairing session to Supabase Storage while connected (ms)
WA_SESSION_BACKUP_INTERVAL_MS=300000
# Public URL of this backend — set to make the service ping itself so Render Free
# never sleeps (e.g. https://medexcrm-whatsapp.onrender.com). Leave empty to disable.
WA_KEEPALIVE_URL=
# Keep-alive interval in minutes (must be under 15)
WA_KEEPALIVE_MINUTES=10

# Frontend: set the backend URL in the WhatsApp module connection card
# (stored in the browser; or set WHATSAPP_API_BASE in public/index.html)
